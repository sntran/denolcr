{
  "name": "rfetch",
  "version": "0.1.0",
  "description": "Fetching between remotes, using Web APIs.",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.2.0"
  },
  "bin": {
    "rfetch": "main.js"
  },
  "main": "mod.js",
  "type": "module",
  "workspaces": [
    "lib",
    "backend/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sntran/rfetch.git"
  },
  "scripts": {
    "start": "node main.js",
    "test": "node --test",
    "bench": "node backend/chunker/main_bench.js && node cmd/lsjson/main_bench.js",
    "worker": "npx wrangler pages dev ."
  },
  "author": "Trần Nguyễn Sơn",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sntran/rfetch/issues"
  },
  "homepage": "https://github.com/sntran/rfetch#readme",
  "dependencies": {
    "@rfetch/alias": "^0.1.0",
    "@rfetch/chunker": "^0.1.0",
    "@rfetch/combine": "^0.1.0",
    "@rfetch/crypt": "^0.1.0",
    "@rfetch/drive": "^0.1.0",
    "@rfetch/http": "^0.1.0",
    "@rfetch/lib": "^0.1.0",
    "@rfetch/local": "^0.1.0",
    "@rfetch/memory": "^0.1.0",
    "@rfetch/s3": "^0.1.0"
  },
  "devDependencies": {
    "fast-check": "^3.19.0"
  }
}
